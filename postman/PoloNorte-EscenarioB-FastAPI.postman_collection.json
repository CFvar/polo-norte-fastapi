                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('devuelve token y rol', () => { pm.expect(b.token).to.be.a('string'); pm.expect(b.rol).to.be.a('string'); });",
