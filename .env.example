# Copia este archivo como .env y ajusta los valores
PORT=8000

# MySQL (Laragon: root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=polonorte_py

# JWT: pon una cadena larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES=2h

# Usuarios de prueba
JEFE_USER=jefe
JEFE_PASSWORD=jefe123
ELFO_USER=elfo
ELFO_PASSWORD=elfo123

# Servicio SOAP MeteoPoloNorteService (usa la URL del docente; el mock local es http://127.0.0.1:8089/meteo)
METEO_URL=http://127.0.0.1:8089/meteo
METEO_SOAP_ACTION=ObtenerPronostico
METEO_TIMEOUT_MS=3000
METEO_MAX_INTENTOS=2
METEO_BACKOFF_MS=300
